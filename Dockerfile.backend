FROM python:3.11-slim

WORKDIR /app

# System deps for asyncpg, bcrypt, etc.
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Install dependencies first (cached unless pyproject.toml changes)
COPY pyproject.toml ./
RUN mkdir -p src && touch src/__init__.py && \
    pip install --no-cache-dir . && \
    rm -rf src

# Copy source code and install the project itself (no dependency re-download)
COPY src/ src/
COPY scripts/ scripts/
RUN pip install --no-cache-dir --no-deps .

# Copy data directory (chroma, course materials, etc.)
COPY data/ data/

EXPOSE 8000

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
