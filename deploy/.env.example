# Copy to .env at the repo root: cp deploy/.env.example .env
# docker-compose.yml automatically reads .env from the repo root.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MODEL_PROVIDER=openai

# --- JWT signing key ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# --- Postgres (matches your current dev defaults) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=pensum_piloten

# --- Neo4j (matches your current dev default) ---
NEO4J_PASSWORD=pensumpiloten

# --- Auto-seed the 36 experiment users from src/api/seed.py on startup ---
SEED_TEST_DATA=true

# --- Replay cached per-course KG triplets into Neo4j on startup ---
# Lets a fresh Neo4j volume inherit the graph previously built by `ingest-kg`
# without re-running LLM extraction. Idempotent — skips scopes already populated.
KG_AUTOLOAD_ON_STARTUP=true
