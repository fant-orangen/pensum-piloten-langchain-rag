# --- LLM Provider ---
LLM_PROVIDER=openai
OPENAI_API_KEY=

IDUN_API_KEY=

# --- OpenAI Model selection ---
LLM_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=pensum_piloten

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVER_TOP_K=5

# --- NEO4J ---
NEO4J_PASSWORD=pensumpiloten

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Optional superadmin bootstrap ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FIRST_NAME=System
SUPERADMIN_LAST_NAME=Admin