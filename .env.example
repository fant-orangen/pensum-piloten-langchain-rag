# --- LLM Provider ---
OPENAI_API_KEY=

# --- Model selection ---
LLM_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=pensum_piloten

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVER_TOP_K=5

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

RERANK_ENABLED=true
RERANK_FETCH_K=25
RERANK_TOP_K=5
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

RERANK_LOG=true
RERANK_LOG_TOP_N=8
RERANK_LOG_PREVIEW_CHARS=120