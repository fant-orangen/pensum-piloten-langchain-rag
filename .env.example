# --- LLM Provider ---
# Supported application providers: "openai" or "anthropic"
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.5
OPENAI_INGESTION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-sonnet-4-6

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=pensum_piloten

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVER_TOP_K=5
NAIVE_RAG_TOP_K=20
KG_EXPANSION_HOPS=1
KG_MAX_EXPANDED_CHUNKS=10
KG_MAX_FINAL_CHUNKS=20
TEMPERATURE=0.3
CONVERSATION_COMPRESSION_TOKEN_LIMIT=1000

# --- NEO4J ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pensumpiloten

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pensum_piloten
SEED_TEST_DATA=false

# --- Auth ---
SECRET_KEY=change-me-in-production

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- Postgres (matches your current dev defaults) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=pensum_piloten

# --- Optional admin bootstrap ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
