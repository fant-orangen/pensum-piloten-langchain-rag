# --- LLM Provider ---
# "openai" for OpenAI API, "local" for IDUN LLM gateway
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_INGESTION_MODEL=gpt-4o

# --- IDUN LLM gateway (used when MODEL_PROVIDER=local) ---
IDUN_BASE_URL=https://llm.hpc.ntnu.no/v1
IDUN_API_KEY=

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=pensum_piloten

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVER_TOP_K=5
NAIVE_RAG_TOP_K=20

# --- NEO4J ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pensumpiloten

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pensum_piloten
SEED_TEST_DATA=false

# --- Auth ---
SECRET_KEY=change-me-in-production

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- Optional admin bootstrap ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
