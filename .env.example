# --- LLM Provider ---
OPENAI_API_KEY=

# --- Model selection ---
LLM_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=pensum_piloten

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVER_TOP_K=5

# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
KG_EXPANSION_HOPS=1
KG_MAX_EXPANDED_CHUNKS=10

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000