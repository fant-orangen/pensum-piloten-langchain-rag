Bootstrap: docker
From: neo4j:5-community

%labels
    Author pensum-piloten
    Description Neo4j 5 Community for Pensum Piloten on IDUN

%environment
    export NEO4J_AUTH=neo4j/pensumpiloten
    export NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
    export NEO4J_server_memory_heap_initial__size=512m
    export NEO4J_server_memory_heap_max__size=1G

%startscript
    exec neo4j console
